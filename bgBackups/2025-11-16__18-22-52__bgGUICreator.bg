function noReturn goToGUICreator   <//> 《
	InvalidateRect</ mainWindow::null::1 /> >> clearMainWindow<//>;
	
	
	renameWindow</ mainWindow::bgguiTitle pointer />;	
》
function noReturn bgguiShowContextMenu   </ :#x:::#y /> 《
	
	menuPointer cm << CreatePopupMenu<//>;
	addStringMenu</ cm::10000::{Create Control} />;
	
	:#id << TrackPopupMenu</ cm::TPM_NONOTIFY | TPM_RETURNCMD::x::y::0::mainWindow::null />;
	? |[id === 10000]| initbgguiDialog<//>;
	
》
function noReturn initbgguiDialog   <//> 《
	bgguiDialog << CreateWindowA</ MAKEINTATOM</ registerbgguiDialogClass<//>/>::{Create Control}::WS_POPUPWINDOW | WS_CAPTION | WS_CLIPCHILDREN::
		300::300::400::300::null::null::null::null />;
》
windowHandler bgguiDialogHandler   </ windowPointer window::positiveInteger32 message::positiveInteger32Pointer parameter1::integer64Pointer parameter2 /> 《
	
	^^^
	DefWindowProc</ window::message::parameter1::parameter2 />;
》
function returns ATOM registerbgguiDialogClass   <//> 《
    	changeable WNDCLASSEXW c; c.cbSize stores bytes</ WNDCLASSEXW />; 
	c.hInstance stores in 》》c.style stores CS_HREDRAW | CS_VREDRAW 》》c.lpfnWndProc stores bgguiDialogHandler;
    	c.cbClsExtra stores null 》》c.cbWndExtra stores null 》》c.hIcon stores null 》》c.hCursor stores LoadCursor</ null::IDC_ARROW />;
    	c.lpszMenuName stores null 》》c.hIconSm stores null 》》c.lpszClassName stores {bggui Dialog};
    	c.hbrBackground stores [! brushPointer !]([! positiveInteger16 !]6);
	^^^
	RegisterClassExW</ &c />;
》


