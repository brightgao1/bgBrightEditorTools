function noReturn bgguiShowContextMenu   </ :#x:::#y /> 《
	
	menuPointer cm << CreatePopupMenu<//>;
	addStringMenu</ cm::10000::{Create Control} />;
	
	:#id << TrackPopupMenu</ cm::TPM_NONOTIFY | TPM_RETURNCMD::x::y::0::mainWindow::null />;
	? |[id === 10000]| initbgguiDialog</ x::y />;
	
》
function noReturn initbgguiDialog   </ :#x:::#y /> 《
	asciiString title;
	bgguiDialog << CreateWindowA</ MAKEINTATOM</ registerbgguiDialogClass<//>/>::title pointer::WS_POPUPWINDOW | WS_CAPTION | WS_CLIPCHILDREN::
		400::100::750::500::null::null::null::null />;
	show</ bgguiDialog />;
	UpdateWindow</ bgguiDialog />;
	EnableWindow</ mainWindow::0 />;
	windowPointer txt;	

	做Text</ txt::{Control Type:\n\n\n\nDirectory:\n\n\n\nText in the new control:\n\n\n\nControl width:}::10::10::400::500::bgguiDialog />;
	
	做</ bgguiDialogControlTypeCB::{combobox}::{}::CBS_DROPDOWN | CBS_HASSTRINGS | WS_CHILD::10::40::300::400::bgguiDialog::null />;
	show</ bgguiDialogControlTypeCB />;
	[]</ :"::@@cbStrings />;
	cbStrings addToEnd</ {Button} />;
	cbStrings addToEnd</ {Checkbox} />;
	cbStrings addToEnd</ {Edit} />;
	cbStrings addToEnd</ {Text} />;
	-> |[i.. cbStrings elementCount]|
		SendMessageW</ bgguiDialogControlTypeCB::CB_ADDSTRING::0::[! integer64Pointer !]cbStrings[i] pointer />;
	renameWindow</ bgguiDialogControlTypeCB::cbStrings[0] pointer />;
	
	做Edit</ bgguiDialogDirectoryEdit::10::140::700::30::bgguiDialog />;	
	做Edit</ bgguiDialogTextEdit::10::235::700::30::bgguiDialog />;
	做</ bgguiDialogWidthEdit::{Edit}::{}::WS_CHILD | WS_BORDER | ES_NUMBER | ES_AUTOHSCROLL::10::330::700::30::mainWindow />;
	renameWindow</ bgguiDialogWidthEdit::{300} />;

	做Anniu</ bgguiDialogButton::{Create (Enter)}::590::380::120::50::bgguiDialog::null />;
	
	setFont</ txt::arialFont />;
	setFont</ bgguiDialogControlTypeCB::arialFont />;
	setFont</ bgguiDialogDirectoryEdit::arialFont />;
	setFont</ bgguiDialogTextEdit::arialFont />;
	renameWindow</ bgguiDialog::{Create Control} />;
	SetFocus</ bgguiDialogControlTypeCB />;
	bgguiContextMenuX << x >> bgguiContextMenuY << y;
