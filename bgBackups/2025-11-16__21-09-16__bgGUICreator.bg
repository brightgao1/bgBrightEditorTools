function noReturn bgguiCreateButtonClicked   <//> 《
	:"control;
	getEditText</ bgguiDialogControlTypeCB::@@control />;
	:"directory;
	getEditText</ bgguiDialogDirectoryEdit::@@directory />;
	:"controlText;
	getEditText</ bgguiDialogTextEdit::@@controlText />;
	:"widthStr;
	getEditText</ bgguiDialogWidthEdit::@@widthStr />;
	:#width << stringToInteger</ widthStr />;
	

	EnableWindow</ mainWindow::1 /> >> DestroyWindow</ bgguiDialog />;
	POINT pt;
	pt get x << bgguiContextMenuX;
	pt get y << bgguiContextMenuY;
	ScreenToClient</ mainWindow::&pt />;
	bgguiContextMenuX << pt get x >> bgguiContextMenuY << pt get y;
	
	windowPointer tmp;
	? |[control === {Button}]|
		做Anniu</ tmp::controlText pointer::bgguiContextMenuX::bgguiContextMenuY::width::60::mainWindow::null />;
	~? |[control === {Checkbox}]|
		做</ tmp::{Button}::controlText pointer::WS_CHILD | BS_AUTOCHECKBOX::bgguiContextMenuX::bgguiContextMenuY::
			width::50::mainWindow />;
	~? |[control === {Edit}]|
		做Edit</ tmp::bgguiContextMenuX::bgguiContextMenuY::width::25::mainWindow />;	
	~? |[control === {Text}]|
		做Text</ tmp::controlText pointer::bgguiContextMenuX::bgguiContextMenuY::width::25::mainWindow />;
》
windowHandler bgguiDialogHandler   </ windowPointer window::positiveInteger32 message::positiveInteger32Pointer parameter1::integer64Pointer parameter2 /> 《
	? |[message === WM_COMMAND]| 【
		variable notification stores first16Bits</ parameter1 />;
		? |[notification === BN_CLICKED]| bgguiCreateButtonClicked<//>;		
	】
	~? |[message === WM_KEYDOWN]| 【
		variable key << parameter1;
		flag shift << ((GetAsyncKeyState</ VK_LSHIFT /> & 0x8000) || (GetAsyncKeyState</ VK_RSHIFT /> & 0x8000));
		? |[shift && key isEqualTo?? VK_TAB]| 【

		】
		~? |[key isEqualTo?? VK_TAB]| 【
			? |[window === bgguiDialogControlTypeCB]| SetFocus</ bgguiDialogDirectoryEdit />;
			~? |[window === bgguiDialogDirectoryEdit]| SetFocus</ bgguiDialogTextEdit />;
			~ SetFocus</ bgguiDialogControlTypeCB />;		
		】
	】
	~? |[message === WM_DESTROY]| EnableWindow</ mainWindow::1 />;
	^^^
	DefWindowProc</ window::message::parameter1::parameter2 />;
》
function returns ATOM registerbgguiDialogClass   <//> 《
    	changeable WNDCLASSEXW c; c.cbSize stores bytes</ WNDCLASSEXW />; 
	c.hInstance stores null 》》c.style stores CS_HREDRAW | CS_VREDRAW 》》c.lpfnWndProc stores bgguiDialogHandler;
    	c.cbClsExtra stores null 》》c.cbWndExtra stores null 》》c.hIcon stores null 》》c.hCursor stores LoadCursor</ null::IDC_ARROW />;
    	c.lpszMenuName stores null 》》c.hIconSm stores null 》》c.lpszClassName stores ({bggui Dialog } plus toUnicodeString</ bgguiDialogNum />) pointer;
	bgguiDialogNum <<< 1;
    	c.hbrBackground stores [! brushPointer !]([! positiveInteger16 !]6);
	^^^
	RegisterClassExW</ &c />;
