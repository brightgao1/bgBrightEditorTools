function noReturn ashSaveButtonClicked   <//> 《
	:"fileExtension.. highlightFilePath << {};
	getEditText</ addSyntaxHighlightFileExtensionEdit::@@fileExtension />;
	highlightFilePath <<< ADbrightEditorSyntaxHighlightFolderPath >> highlightFilePath addToEnd</ '\\' /> >> highlightFilePath <<< fileExtension;
	? |[(pathExists</ highlightFilePath />) isEqualTo?? 0]| newFile</ highlightFilePath />;
	[]</ :"::@@highlightFile />;
	fileToDynamicArray</ highlightFilePath::highlightFile />;
	/!highlightFile elementCount;
	flag error << 0;
	[]</ :"::@@emptyEdits />;
	[]</ :"::@@wrongFormat />;
	? |[fileExtension elementCount === 0]| error << 1 >> emptyEdits addToEnd</ {File Extension} />;

	:"toHighlight stores {};
	getEditText</ addSyntaxHighlightToHighlightEdit::@@toHighlight />;
	toHighlight << trimString</ toHighlight />;		
	? |[toHighlight elementCount === 0]| error << 1 >> emptyEdits addToEnd</ {To Highlight} />;
	

	:"redStr stores {};
	getEditText</ addSyntaxHighlightRedEdit::@@redStr />;
	redStr << trimString</ redStr />;	
	flag redHasLetters << 0;
	? |[redStr elementCount === 0]| error << 1 >> emptyEdits addToEnd</ {Red} />;
	? |[hasLetters</ redStr />]| error << 1 >> wrongFormat addToEnd</ {Red} />;

	:"greenStr stores {};
	getEditText</ addSyntaxHighlightGreenEdit::@@greenStr />;
	greenStr << trimString</ greenStr />;
	? |[greenStr elementCount === 0]| error << 1 >> emptyEdits addToEnd</ {Green} />;
	? |[hasLetters</ greenStr />]| error << 1 >> wrongFormat addToEnd</ {Green} />;

	:"blueStr stores {};
	getEditText</ addSyntaxHighlightBlueEdit::@@blueStr />;
	blueStr << trimString</ blueStr />;
	? |[blueStr elementCount === 0]| error << 1 >> emptyEdits addToEnd</ {Blue} />;
	? |[hasLetters</ blueStr />]| error << 1 >> wrongFormat addToEnd</ {Blue} />;

	:"otherStr stores {};
	getEditText</ addSyntaxHighlightOtherEdit::@@otherStr />;
	otherStr << trimString</ otherStr />;
	? |[otherStr elementCount === 0]| error << 1 >> emptyEdits addToEnd</ {Other} />;	

	///!toHighlight >> /^ >> /!redStr >> /^ >> /!greenStr >> /^ >> /!blueStr >> /^ >> /!otherStr >> /^;	
	//alert</ (toHighlight plus space plus redStr) pointer />;
	? |[error]| 【
		unicodeString errMessage;
		? |[emptyEdits elementCount isGreaterThan?? 0]| 【
			errMessage storesItselfPlus</ {ERROR.\n\nThe following were blank: \n} />;
			-> |[i.. emptyEdits elementCount]| errMessage <<< emptyEdits[i] >> errMessage addToEnd</ '\n' />;
			repeat |[2]| errMessage addToEnd</ '\n' />;
		】
		? |[wrongFormat elementCount isGreaterThan?? 0]| 【
			errMessage storesItselfPlus</ {There were alphabetic characters found in the following:\n} />;
			-> |[i.. wrongFormat elementCount]| errMessage <<< wrongFormat[i] >> errMessage addToEnd</ '\n' />;
		】
		alert</ errMessage pointer />;
		^^^;
	】
	? |[redStr elementCount isGreaterThan?? 3]| redStr << {255};
	? |[greenStr elementCount isGreaterThan?? 3]| greenStr << {255};
	? |[blueStr elementCount isGreaterThan?? 3]| blueStr << {255};
	:#redVal.. greenVal.. blueVal;			
	redVal << stringToInteger</ redStr />;
	greenVal << stringToInteger</ greenStr />;
	blueVal << stringToInteger</ blueStr />;
	? |[redVal isGreaterThan?? 255]| redStr << {255};
	~? |[redVal isLessThan?? 0]| redStr << {0};
	? |[greenVal isGreaterThan?? 255]| greenStr << {255};
	~? |[greenVal isLessThan?? 0]| greenStr << {0};
	? |[blueVal isGreaterThan?? 255]| blueStr << {255};
	~? |[blueVal isLessThan?? 0]| blueStr << {0};
	renameWindow</ addSyntaxHighlightRedEdit::redStr pointer />;
	renameWindow</ addSyntaxHighlightGreenEdit::greenStr pointer />;
	renameWindow</ addSyntaxHighlightBlueEdit::blueStr pointer />;
	
	:"newStr << {};
	newStr <<< toHighlight >> newStr <<< '\n';
	newStr <<< redStr >> newStr <<< space >> newStr <<< greenStr >> newStr <<< space >> newStr <<< blueStr >> newStr <<< space;
	newStr <<< otherStr;
	
	/^ >> /!{newStr: } >> /!newStr;

	highlightFile addToEndOfArray</ newStr />;
	[]</ :"::@@finalHighlightFile />;
	-> |[i..highlightFile elementCount]| 【
		? |[highlightFile[i] elementCount isGreaterThan?? 0]| finalHighlightFile addToEndOfArray</ highlightFile[i] />;
	】
	dynamicArrayToFile</ highlightFilePath::finalHighlightFile />;	
	:"communicationFilePath;
	communicationFilePath << ADbrightEditorPath;
	communicationFilePath <<< {\\} >> communicationFilePath <<< {syntaxHighlightAdded};
	newFile</ communicationFilePath />;

	:"successMessage << {};
	successMessage <<< unicodeLiteral</ Successfully added! />;
	repeat |[2]| successMessage addToEnd</ '\n' />;
	successMessage <<< toHighlight >> successMessage <<< { } >> successMessage <<< unicodeLiteral</ will be highlighted in . />;
	successMessage <<< fileExtension >> successMessage addToEnd</ space /> >> successMessage <<< unicodeLiteral</ files. />;
	repeat |[2]| successMessage addToEnd</ '\n' />;
	successMessage <<< {Red: } >> successMessage <<< redStr >> successMessage addToEnd</ '\n' />;
	successMessage <<< {Green: } >> successMessage <<< greenStr >> successMessage addToEnd</ '\n' />;
	successMessage <<< {Blue: } >> successMessage <<< blueStr >> successMessage addToEnd</ '\n' />;
	alert</ successMessage pointer />;
》
