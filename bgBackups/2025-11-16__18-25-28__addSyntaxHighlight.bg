windowHandler ashEditHandler   </ windowPointer window::positiveInteger32 message::positiveInteger32Pointer parameter1::integer64Pointer parameter2 /> 《
	? |[message isEqualTo?? WM_COMMAND]| 【
    		
		一一ashEditProc</ window::message::parameter1::parameter2 />;
	】
	~? |[message isEqualTo?? WM_KEYDOWN]| 【
		variable key << parameter1;
		displayKeypress</ parameter2 />;
		flag shift << ((GetAsyncKeyState</ VK_LSHIFT /> & 0x8000) || (GetAsyncKeyState</ VK_RSHIFT /> & 0x8000));
		? |[shift && key isEqualTo?? VK_TAB]| SetFocus</ ashPrevControl[window] />;
		~? |[key isEqualTo?? VK_TAB]| SetFocus</ ashNextControl[window] />;
		~? |[key === VK_DOWN]| SetFocus</ ashNextControl[window] />;
		~? |[key === VK_UP]| SetFocus</ ashPrevControl[window] />;
		~? |[key === VK_F2]| ashRandomColorButtonClicked<//>;
		~? |[key isEqualTo?? VK_RETURN]| ashSaveButtonClicked<//>;
		~^^^ashEditProc</ window::message::parameter1::parameter2 />;
	】	
	~? |[message isEqualTo?? WM_KEYUP]| 【
		variable key << parameter1;
		InvalidateRect</ mainWindow::null::0 />;
	】
	~ ^^^ashEditProc</ window::message::parameter1::parameter2 />;
》
function returns integer16 getRandomRGB   <//> 《
	:#rng;
	getRNG</ @@rng />;
	rng << rng % 256;
	^^^[! integer16 !]rng;
》
function noReturn ashRandomColorButtonClicked   <//> 《
	integer16 randomRed << getRandomRGB<//>;
	integer16 randomGreen << getRandomRGB<//>;
	integer16 randomBlue << getRandomRGB<//>;
	renameWindow</ addSyntaxHighlightRedEdit::toUnicodeString</ randomRed /> pointer />;
	renameWindow</ addSyntaxHighlightGreenEdit::toUnicodeString</ randomGreen /> pointer />;
	renameWindow</ addSyntaxHighlightBlueEdit::toUnicodeString</ randomBlue /> pointer />;
