function noReturn setWhiteTextBackground   </ windowPointer w /> 《
	SetBkColor</ GetDC</ w />::RGB</ 255::255::255 /> />;
》
function noReturn handleMainWindowCommandMessage   </ windowPointer window::positiveInteger32 message::positiveInteger32Pointer parameter1::integer64Pointer parameter2 /> 《
	variable notification << first16Bits</ parameter1 />;
	? |[notification isEqualTo?? BN_CLICKED]| 【
		windowPointer butt << ([! windowPointer !]parameter2);
		? |[butt isEqualTo?? ashSaveButton]| ashSaveButtonClicked<//>;
	】
》
function noReturn clearMainWindow   <//> 《
	hide</ addSyntaxHighlightFileExtensionText /> >> hide</ addSyntaxHighlightFileExtensionEdit />;
	hide</ addSyntaxHighlightToHighlightText /> >> hide</ addSyntaxHighlightToHighlightEdit />;
	hide</ addSyntaxHighlightRedText /> >> hide</ addSyntaxHighlightRedEdit />;
	hide</ addSyntaxHighlightGreenText /> >> hide</ addSyntaxHighlightGreenEdit />;
	hide</ addSyntaxHighlightBlueText /> >> hide</ addSyntaxHighlightBlueEdit />;
	hide</ addSyntaxHighlightOtherText /> >> hide</ addSyntaxHighlightOtherEdit /> >> hide</ ashSaveButton />;
》
function returns unicodeString bgGetEditText   </ windowPointer edit /> 《
	wideCharacter b[1000];
	unicodeString s;
	GetWindowTextW</ b::1000 /> >> s << b;
	^^^s;
》
