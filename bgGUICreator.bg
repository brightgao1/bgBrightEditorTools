function noReturn goToGUICreator   <//> 《
	InvalidateRect</ mainWindow::null::1 /> >> clearMainWindow<//>;
	
	
	renameWindow</ mainWindow::bgguiTitle pointer />;	
》
function noReturn bgguiShowContextMenu   </ :#x:::#y /> 《
	
	menuPointer cm << CreatePopupMenu<//>;
	addStringMenu</ cm::10000::{Create Button} />;
	addStringMenu</ cm::10010::{Create Checkbox} />;
	addStringMenu</ cm::10020::{Create Edit} />;
	addStringMenu</ cm::10030::{Create Text} />;
	
	:#id << TrackPopupMenu</ cm::TPM_NONOTIFY | TPM_RETURNCMD::x::y::0::mainWindow::null />;
	? |[id === 10000]| initbgguiDialog</ x::y::{Button} />;
	~? |[id === 10010]| initbgguiDialog</ x::y::{Checkbox} />;
	~? |[id === 10020]| initbgguiDialog</ x::y::{Edit} />;
	~ initbgguiDialog</ x::y::{Text} />;
》
function noReturn initbgguiDialog   </ :#x:::#y:::"controlType /> 《
	asciiString title;
	bgguiDialog << CreateWindowA</ MAKEINTATOM</ registerbgguiDialogClass<//>/>::title pointer::WS_POPUPWINDOW | WS_CAPTION | WS_CLIPCHILDREN::
		400::100::750::500::null::null::null::null />;
	show</ bgguiDialog />;
	UpdateWindow</ bgguiDialog />;
	EnableWindow</ mainWindow::0 />;
	windowPointer txt;
	
	做Text</ txt::{Control Type:\n\n\n\nVariable name:\n\n\n\nText in the new control:\n\n\n\nControl width:}::10::10::400::500::bgguiDialog />;
	
	做</ bgguiDialogControlTypeCB::{combobox}::{}::CBS_DROPDOWN | CBS_HASSTRINGS | WS_CHILD::10::40::300::400::bgguiDialog::null />;
	show</ bgguiDialogControlTypeCB />;
	[]</ :"::@@cbStrings />;
	cbStrings addToEnd</ {Button} />;
	cbStrings addToEnd</ {Checkbox} />;
	cbStrings addToEnd</ {Edit} />;
	cbStrings addToEnd</ {Text} />;
	-> |[i.. cbStrings elementCount]|
		SendMessageW</ bgguiDialogControlTypeCB::CB_ADDSTRING::0::[! integer64Pointer !]cbStrings[i] pointer />;
	-> |[i.. cbStrings elementCount]| ? |[controlType === cbStrings[i]]|
		renameWindow</ bgguiDialogControlTypeCB::cbStrings[i] pointer />;
	
	做Edit</ bgguiDialogVarNameEdit::10::140::700::30::bgguiDialog />;	
	做Edit</ bgguiDialogTextEdit::10::235::700::30::bgguiDialog />;
	做</ bgguiDialogWidthEdit::{Edit}::{}::WS_CHILD | WS_BORDER | ES_NUMBER | ES_AUTOHSCROLL::10::330::700::30::bgguiDialog />;
	renameWindow</ bgguiDialogWidthEdit::{300} />;

	做Anniu</ bgguiDialogButton::{Create (Enter)}::590::380::120::50::bgguiDialog::null />;
	
	setFont</ txt::arialFont />;
	setFont</ bgguiDialogControlTypeCB::arialFont />;
	setFont</ bgguiDialogVarNameEdit::arialFont />;
	setFont</ bgguiDialogTextEdit::arialFont />;
	setFont</ bgguiDialogWidthEdit::arialFont />;
	SetFocus</ bgguiDialogVarNameEdit />;
	bgguiContextMenuX << x >> bgguiContextMenuY << y;
	
	bgguiDialogEditProc << ([! WNDPROC !]GetWindowLongPtrW</ bgguiDialogVarNameEdit::-4 />);
	SetWindowLongPtrW</ bgguiDialogVarNameEdit::-4::[! LONG_PTR !]bgguiDialogEditHandler />;
	SetWindowLongPtrW</ bgguiDialogTextEdit::-4::[! LONG_PTR !]bgguiDialogEditHandler />;
	SetWindowLongPtrW</ bgguiDialogWidthEdit::-4::[! LONG_PTR !]bgguiDialogEditHandler />;
	
	bgguiDialogCBProc << ([! WNDPROC !]GetWindowLongPtrW</ bgguiDialogControlTypeCB::-4 />);
	SetWindowLongPtrW</ bgguiDialogControlTypeCB::-4::[! LONG_PTR !]bgguiDialogCBHandler />;
	
	
