	】
	~? |[message isEqualTo?? WM_SIZE]| 【
    		:"title; 
		getEditText</ mainWindow::@@title />;
		? |[title isEqualTo?? ashTitle]| resizeWindowAddSyntaxHighlight<//>;
	】
	~? |[message isEqualTo?? WM_CTLCOLORSTATIC]| 【
		setWhiteTextBackground</ window />;
		^^^[! INT_PTR !]whiteBrush;
	】
    ··· |[ message isEqualTo?? WM_PAINT ]| 【
        changeable PAINTSTRUCT ps;
        changeable HDC hdc stores BeginPaint</ window::&ps />;
		rectangle r;
		:"redStr.. greenStr..blueStr;
		r get left << 20 >> r get right << 350 >> r get top << 300 >> r get bottom << 360;
		getEditText</ addSyntaxHighlightRedEdit::@@redStr />;
		getEditText</ addSyntaxHighlightGreenEdit::@@greenStr />;
		getEditText</ addSyntaxHighlightBlueEdit::@@blueStr />;
		? |[hasLetters</ redStr /> || hasLetters</ greenStr /> || hasLetters</ blueStr />]| 【】
		~ 【 
			:#redVal.. greenVal.. blueVal;
			redVal << 0 >> greenVal << 0 >> blueVal << 0;
			? |[redStr elementCount isGreaterThan?? 3 || stringToInteger</ redStr /> isGreaterThan?? 255]| 【
				redVal << 255;
			】
			~ redVal << stringToInteger</ redStr />;
			? |[greenStr elementCount isGreaterThan?? 3 || stringToInteger</ greenStr /> isGreaterThan?? 255]| 【
				greenVal << 255;
			】
			~ greenVal << stringToInteger</ greenStr />;
			? |[blueStr elementCount isGreaterThan?? 3 || stringToInteger</ blueStr /> isGreaterThan?? 255]| 【
				blueVal << 255;
			】
			~ blueVal << stringToInteger</ blueStr />;
			FillRect</ hdc::&r::CreateSolidBrush</ RGB</ redVal::greenVal::blueVal /> /> />;
      		
		】
		EndPaint</ window::&ps />;
    】
	~? |[message isEqualTo?? WM_TIMER]| 【
		//set focus to first field by using title to determine what screen currently on
		:#timerID << [! integer32 !]parameter1;
