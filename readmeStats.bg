function noReturn goToReadmeStats   <//> 《
	InvalidateRect</ mainWindow::null::1 /> >> clearMainWindow<//>;
	? |[rmsPathText === null]| 【
		做Text</ rmsPathText::{Full path of README.md:}::20::10::400::30::mainWindow />;
		setFont</ rmsPathText::arialFont />;
	】
	? |[rmsPathEdit === null]| 【
		做Edit</ rmsPathEdit::20::42::400::30::mainWindow />;
		setFont</ rmsPathEdit::arialFont />;
	】

	? |[rmsCheckbox === null]| 【
		做</ rmsCheckbox::{Button}::{Sync README with BrightEditor Statistics}::WS_CHILD | BS_AUTOCHECKBOX::20::90::500::50::mainWindow />;
		setFont</ rmsCheckbox::arialFont />;
	】
	? |[rmsIntervalText === null]| 【
		做Text</ rmsIntervalText::{Milliseconds per write:}::20::190::400::30::mainWindow />;
		setFont</ rmsIntervalText::arialFont />;
	】
	? |[rmsIntervalEdit === null]| 【
		做</ rmsIntervalEdit::{Edit}::{}::WS_CHILD | WS_BORDER | ES_NUMBER | ES_AUTOHSCROLL::20::222::400::30::mainWindow />;
		setFont</ rmsIntervalEdit::arialFont />;
	】
	
	show</ rmsPathText /> >> show</ rmsPathEdit />;
	show</ rmsCheckbox />;

	? |[rmsCheckboxChecked<//>]| 【
		show</ rmsIntervalEdit />;
		show</ rmsIntervalText />;
	】
	~ 【
